# 引擎（setup 时从 GitHub 拉取，不进 skill 包）
# 约 16MB / 38 万个文件（three.js 展开），打进来会让分发极重。
# 见 vendor/ATTRIBUTION.md
engine/
.engine-fetch/

# 依赖（setup 时 npm install，约 130MB）
node_modules/

# 视频项目产物（ftnew.py 建的项目通常放在别处，但兜底）
out/
audio/
*.mp4
*.srt

# 本地成片库（课程集数等，几十上百 MB，不入库）
output/
example-output/

# Python
__pycache__/
*.pyc

# 编辑器
.vscode/
.idea/
.DS_Store
# 本地工作区数据（不公开）
.workbuddy/
/anatomy

# examples/sample 由 ftasset.py / ftvoice.py 生成的产物：
# 仓库只提交「输入」（script.js / pages / assets.json / assets/raw），
# 生成物一律不入库，否则换素材会污染 diff。
examples/sample/extras/
examples/sample/assets/svg/
examples/sample/assets/clips/
examples/sample/out/
examples/sample/audio/
examples/sample/voice.js
examples/sample/engine/
examples/sample/engine_modules/
